---
---

<div class="placeholder-loading">
  <div class="pixel-spinner show">
    <div class="pixel-grid">
      <div class="pixel p1"></div>
      <div class="pixel p2"></div>
      <div class="pixel p3"></div>
      <div class="pixel p4"></div>
      <div class="pixel p5"></div>
      <div class="pixel p6"></div>
      <div class="pixel p7"></div>
      <div class="pixel p8"></div>
    </div>
  </div>
</div>

<style lang="scss">
.placeholder-loading {
  --pixel-color-1: #555;
  --pixel-color-2: #aaa;
  --pixel-color-3: #777;
  --pixel-size: 9px;
  --pixel-gap: 3px;
  --animation-duration: 0.9s;

  align-items: center;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  padding: 1rem;
  min-height: 104px;
}

.pixel-spinner {
  opacity: 0;
  transition: opacity 0.15s ease;

  &.show {
    opacity: 1;
  }

  &.v-enter,
  &.v-leave-active {
    opacity: 0;
  }

  &.v-enter-active,
  &.v-leave {
    opacity: 1;
  }
}

.pixel-grid {
  display: grid;
  grid-template-columns: repeat(3, var(--pixel-size));
  grid-template-rows: repeat(3, var(--pixel-size));
  gap: var(--pixel-gap);
  /* Place 8 pixels around the center (clock positions) */
  /* We'll use explicit grid placement */
}

.pixel {
  width: var(--pixel-size);
  height: var(--pixel-size);
  image-rendering: pixelated;
  /* Pixel-art style: flat with a subtle darker bottom/right edge */
  box-shadow:
    1px 1px 0 #2a2a2a,
    inset 2px 2px 0px rgba(255, 255, 255, 0.15);
}

/*
  Grid positions (col / row):
  1,1  1,2  1,3
  2,1  2,2  2,3   <- center is 2,2 (empty)
  3,1  3,2  3,3

  Clock order starting top-left going clockwise:
  p1 = top-left     (1,1)
  p2 = top-center   (1,2)
  p3 = top-right    (1,3)
  p4 = mid-right    (2,3)
  p5 = bot-right    (3,3)
  p6 = bot-center   (3,2)
  p7 = bot-left     (3,1)
  p8 = mid-left     (2,1)
*/

.p1 { grid-column: 1; grid-row: 1; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(0 * var(--animation-duration) / 8); }
.p2 { grid-column: 2; grid-row: 1; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(1 * var(--animation-duration) / 8); }
.p3 { grid-column: 3; grid-row: 1; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(2 * var(--animation-duration) / 8); }
.p4 { grid-column: 3; grid-row: 2; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(3 * var(--animation-duration) / 8); }
.p5 { grid-column: 3; grid-row: 3; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(4 * var(--animation-duration) / 8); }
.p6 { grid-column: 2; grid-row: 3; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(5 * var(--animation-duration) / 8); }
.p7 { grid-column: 1; grid-row: 3; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(6 * var(--animation-duration) / 8); }
.p8 { grid-column: 1; grid-row: 2; animation: pixel-pulse var(--animation-duration) ease-in-out infinite; animation-delay: calc(7 * var(--animation-duration) / 8); }

@keyframes pixel-pulse {
  0%, 100% {
    background-color: var(--pixel-color-3);
    transform: scale(0.75);
    opacity: 0.4;
  }
  30% {
    background-color: var(--pixel-color-2);
    transform: scale(1);
    opacity: 1;
  }
  60% {
    background-color: var(--pixel-color-1);
    transform: scale(0.9);
    opacity: 0.75;
  }
}
</style>